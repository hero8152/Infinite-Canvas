# Host port for the web UI.
INFINITE_CANVAS_PORT=13200

# Published image. Override this if your fork lives under another GitHub owner/name.
INFINITE_CANVAS_IMAGE=ghcr.io/zhao-wuyan/infinite-canvas:latest

# ComfyUI backends used by the container.
# If ComfyUI runs on the same machine as Docker, keep host.docker.internal:8188.
# If ComfyUI runs on another computer, use its LAN address, for example:
# COMFYUI_INSTANCES=192.168.1.20:8188
COMFYUI_INSTANCES=host.docker.internal:8188
